{
  "name": "prediction-markets-arb",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "postinstall": "node scripts/check-workspace-links.mjs --fix",
    "check:links": "node scripts/check-workspace-links.mjs",
    "build": "npm run build --workspaces --if-present",
    "dev:event-bus": "npm run dev -w services/event-bus",
    "dev:ingestion": "npm run dev -w services/ingestion",
    "dev:pipeline": "npm run dev -w services/pipeline",
    "dev:solver": "npm run dev -w services/arb-solver",
    "clean": "rimraf packages/*/dist services/*/dist",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/node": "^22.0.0",
    "rimraf": "^6.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
