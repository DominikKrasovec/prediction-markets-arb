{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EventReverifyResult",
  "description": "Pass-2 YES-region re-verification verdict (W3-A, paper-grounded audit 2026-06-10). The relation is an event-grain comparison of the two sides' covered YES-regions over the shared atomic outcome space Omega; same_event is true exactly when the relation is not 'different_event'.",
  "type": "object",
  "required": ["yes_region_a", "yes_region_b", "relation", "same_event", "confidence", "reasoning"],
  "additionalProperties": false,
  "properties": {
    "yes_region_a": { "type": "string", "minLength": 1, "maxLength": 600 },
    "yes_region_b": { "type": "string", "minLength": 1, "maxLength": 600 },
    "relation": {
      "type": "string",
      "enum": ["equivalent", "a_subset_of_b", "b_subset_of_a", "partial_overlap", "different_event"]
    },
    "same_event": { "type": "boolean" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "divergence_notes": { "type": ["string", "null"], "maxLength": 600 },
    "reasoning": { "type": "string", "minLength": 1, "maxLength": 1000 }
  }
}
