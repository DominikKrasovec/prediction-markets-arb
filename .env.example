# ── PostgreSQL ────────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5433
PG_DATABASE=prediction_arb
PG_USER=arb
PG_PASSWORD=arb_local_dev

# ── Event Bus (embedded in pipeline service) ─────────────
EVENT_BUS_PORT=3100
EVENT_BUS_URL=http://localhost:3100

# ── LLM Provider Keys (at least one required) ───────────
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...
OPENROUTER_API_KEY=sk-...

# ── Scraper / Platform API Keys ─────────────────────────
OPINION_API_KEY=
PREDICT_API_KEY=               # required — from api.predict.fun dashboard
LIMITLESS_API_KEY=             # X-API-Key header — REST scraping + WebSocket auth (lifecycle + orderbook)
LIMITLESS_API_SECRET=          # HMAC signing secret — order placement only (not needed for read-only scraping)

# ── Kalshi Authentication (required for WSS lifecycle + authenticated REST) ──
# Get your key ID + RSA private key from: https://kalshi.com/account/api
KALSHI_KEY_ID=                 # UUID from account settings, e.g. 00000000-0000-0000-0000-000000000000
# Choose ONE of:
KALSHI_KEY_PATH=               # path to PEM file, e.g. ./secrets/kalshi.key
# KALSHI_KEY_PEM=              # inline PEM with literal \n for newlines (alternative to KALSHI_KEY_PATH)
# Optional overrides (defaults shown):
# KALSHI_BASE_URL=https://api.elections.kalshi.com/trade-api/v2
# KALSHI_WS_URL=wss://api.elections.kalshi.com   # path /trade-api/ws/v2 is appended automatically

# ── Pipeline Tuning (optional — all have defaults) ──────
# SCRAPE_INTERVAL_MS=3600000        # 1 hour
# FULL_RUN_INTERVAL_MS=300000       # 5 minutes
# PIPELINE_BATCH_SIZE=50
# LLM_EXTRACTION_BATCH_SIZE=5
# LLM_CLUSTER_MAX_SIZE=15
# LLM_CLUSTERS_PER_RUN=20

# ── LLM Model Overrides (optional) ──────────────────────
# Pattern: LLM_<TASK>_PROVIDER / LLM_<TASK>_MODEL
# Tasks: EXTRACTION, GROUPING, IMPLICATION, LOGICAL, EMBEDDING, EVENT_CLASSIFICATION
# LLM_EXTRACTION_PROVIDER=deepseek
# LLM_EXTRACTION_MODEL=deepseek-v4-flash
# LLM_IMPLICATION_PROVIDER=deepseek
# LLM_IMPLICATION_MODEL=deepseek-v4-flash
# LLM_EVENT_CLASSIFICATION_PROVIDER=deepseek
# LLM_EVENT_CLASSIFICATION_MODEL=deepseek-v4-flash
# LLM_EMBEDDING_MODEL=text-embedding-3-small

# ── Matching Thresholds (optional — all have defaults) ──
# TITLE_JACCARD_MIN=0.40
# TITLE_LEVENSHTEIN_MIN=0.70
# ENTITY_OVERLAP_MIN=0.50
# PAIR_COMBINED_SCORE_MIN=0.55
# EQUIVALENCE_TITLE_SIM_MIN=0.92
# EMBED_SIMILARITY_THRESHOLD=0.82   # DEPRECATED / no code reader (kept for docs; alias of EMBEDDING_SIMILARITY_THRESHOLD)
# MIN_ENTITY_OVERLAP_EMBEDDING=0.30

# ── Event embedding (Stage 2c) — EMBED_* family (optional) ──
# Consolidated from EVENT_EMBED_* / EVENT_EMBEDDING_* (naming audit T3-1). Old
# names still work via a deprecated alias (a one-time warn is logged when hit).
# EMBED_MODEL=text-embedding-3-small          # alias: EVENT_EMBEDDING_MODEL
# EMBED_CHILD_SAMPLE=60                        # alias: EVENT_EMBED_CHILD_SAMPLE
# EMBED_DATE_HORIZON_DAYS=120                  # alias: EVENT_EMBED_DATE_HORIZON_DAYS
# EMBED_EVENT_PAGE_SIZE=1000                   # alias: EVENT_EMBED_PAGE_SIZE (NOT EMBED_PAGE_SIZE — that
#                                             #   bare name is a distinct Stage-1c market-embed knob, default 2000)
# EMBED_DUMP_PAGE=2000                         # alias: EVENT_EMBED_DUMP_PAGE (dump-event-embeddings script)

# ── Arb Detection / Solver — SOLVE_* family (optional) ──
# Consolidated from SOLVER_* + bare solver knobs (naming audit T3-1). Old names
# still work via a deprecated alias (one-time warn on use).
# Scalar knobs (canonical=default   # alias):
# ARB_MIN_PROFIT=0.01
# SOLVE_MIN_EDGE_CONFIDENCE=0.70               # alias: MIN_EDGE_CONFIDENCE
# SOLVE_DEBOUNCE_MS=10
# SOLVE_MAX_VALID_STATES=10000                 # alias: MAX_VALID_STATES
# SOLVE_CLUSTER_SIZE_CAP=200                   # alias: CLUSTER_SIZE_CAP
# SOLVE_FACET_CLUSTER_QUESTION_CAP=2000        # alias: FACET_CLUSTER_QUESTION_CAP
# SOLVE_PRICE_PERSIST_INTERVAL_MS=30000        # alias: PRICE_PERSIST_INTERVAL_MS
# SOLVE_WORKER_COUNT=<max(1,min(cores-2,6))>   # alias: SOLVER_WORKER_COUNT
# SOLVE_YIELD_EVERY=50
# SOLVE_ENGINE=facet                           # vrep | facet | hybrid
#
# Boolean flags — POLARITY LEGEND (values are '1'/'0' or 'true'/'false'):
#   [default-OFF]  unset ⇒ OFF; set to 1/true to enable   (guard: === '1' / envFlag(_,false))
#   [default-ON ]  unset ⇒ ON;  set to 0/false to disable  (guard: !== '0' / envFlag(_,true))
# SOLVE_WORKER_POOL=0            # [default-OFF]  alias: SOLVER_WORKER_POOL
# SOLVE_SKIP_FILTER=0           # [default-OFF]
# SOLVE_COST_SPLIT=0            # [default-OFF]
# SOLVE_SERIAL_DEDUP=1          # [default-ON ]
# SOLVE_RELAXED_ROUTE=1         # [default-ON ]
# CLOB_IO_THREAD=0             # [default-OFF]
# CLOB_LIVE_SUBSCRIBE_GATE=1   # [default-ON ]
# ARB_SETTLEMENT_FRONTIER=1    # [default-ON ]
# ARB_SETTLEMENT_DISPUTED_LAG=0 # [default-OFF]
# ARB_VENUE_ROUNDING=1         # [default-ON ]
# ARB_GRADED_RESIDUAL=0        # [default-OFF]
# ARB_QUOTE_TTL_MS=120000
# ARB_TOB_TTL_MS=300000
#
# Pipeline boolean flags:
# EMBED_MARKETS=0              # [default-OFF]  Stage-1c market embedding (=== '1')
# EMBED_PARLAYS=0              # [default-OFF]  =1 opts parlays back INTO embedding (skip = !== '1')
# ENTITY_ENRICHMENT_SKIP=0     # [default-OFF]  =1 skips entity enrichment (=== '1')
#
# Reusable backfill scripts — scoped names (naming audit T3-2; bare aliases work):
# BACKFILL_BATCH_SIZE=200      # alias: BATCH_SIZE
# BACKFILL_CONCURRENCY=8       # alias: CONCURRENCY
# BACKFILL_CATEGORY=weather    # alias: CATEGORY  (backfill-kalshi-weather)
# BACKFILL_PATTERN=            # alias: PATTERN   (backfill-text-det-scoped; required)
# BACKFILL_LIMIT=              # alias: LIMIT     (backfill-space-invariant-aliases)

# ── CLOB Adapter URLs (optional — all have defaults) ────
# POLYMARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
# PREDICT_WS_URL=wss://api.predict.org/ws
# OPINION_WS_URL=wss://ws.opinion.trade
# OPINION_API_URL=https://api.opinion.trade
# PROBABLE_API_URL=https://api.probable.bet
# PROBABLE_POLL_MS=2000
